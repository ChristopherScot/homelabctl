package main

// A TUI looks untestable and is not: Update is a pure function from
// (state, message) to state, so the whole interface can be driven
// without a terminal. These tests send messages directly.

import (
	"strings"
	"testing"

	"charm.land/bubbles/v2/list"
	tea "charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
)

// The list is sized from the window minus whatever frame appStyle adds.
//
// Getting this wrong is not subtle but it is easy: hardcode the padding
// here and in the style, change one, and the list runs a row past the
// bottom of the terminal with its own help line scrolled off. Deriving
// it from GetFrameSize keeps the two in step.
func TestListIsSizedToTheWindowMinusItsFrame(t *testing.T) {
	m, _ := newModel().Update(tea.WindowSizeMsg{Width: 100, Height: 40})

	h, v := appStyle.GetFrameSize()
	if got, want := m.(model).list.Width(), 100-h; got != want {
		t.Errorf("list width = %d, want %d (window 100 minus frame %d)", got, want, h)
	}
	if got, want := m.(model).list.Height(), 40-v; got != want {
		t.Errorf("list height = %d, want %d (window 40 minus frame %d)", got, want, v)
	}
}

// Everything the list draws has to fit the width it was given, or it
// overflows whatever is beside it.
func TestRenderedListStaysWithinItsWidth(t *testing.T) {
	m, _ := newModel().Update(tea.WindowSizeMsg{Width: 60, Height: 20})

	for i, line := range strings.Split(m.(model).list.View(), "\n") {
		if w := lipgloss.Width(line); w > m.(model).list.Width() {
			t.Errorf("line %d is %d wide, list width is %d", i, w, m.(model).list.Width())
		}
	}
}

// q quits - but not while the filter is open, or a name containing "q"
// could not be typed. This is the bug the FilterState check prevents.
func TestQuitKey(t *testing.T) {
	for _, tc := range []struct {
		name      string
		filtering bool
		wantQuit  bool
	}{
		{"idle", false, true},
		{"filtering", true, false},
	} {
		t.Run(tc.name, func(t *testing.T) {
			m := newModel()
			m.list.SetSize(80, 24)
			if tc.filtering {
				// Open the filter the way the user does.
				updated, _ := m.Update(tea.KeyPressMsg{Code: '/', Text: "/"})
				m = updated.(model)
				if m.list.FilterState() != list.Filtering {
					t.Fatal("filter did not open")
				}
			}

			_, cmd := m.Update(tea.KeyPressMsg{Code: 'q', Text: "q"})

			// tea.Quit is a Cmd; calling it yields tea.QuitMsg.
			quit := false
			if cmd != nil {
				if _, ok := cmd().(tea.QuitMsg); ok {
					quit = true
				}
			}
			if quit != tc.wantQuit {
				t.Errorf("quit = %v, want %v", quit, tc.wantQuit)
			}
		})
	}
}

// The help line tells the user how to leave. A TUI that traps someone in
// an alt-screen with no visible way out is the worst failure this can
// have, so it is worth a test.
//
// Asserting on "quit" alone, not "q quit": the rendered help carries
// ANSI styling between the key and its label, so the two are not
// adjacent in the output even though they are on screen.
func TestViewShowsHowToQuit(t *testing.T) {
	m, _ := newModel().Update(tea.WindowSizeMsg{Width: 80, Height: 24})

	if content := m.(model).View().Content; !strings.Contains(content, "quit") {
		t.Errorf("view does not say how to quit:\n%s", content)
	}
}

// Lip Gloss v2 removed AdaptiveColor, so components no longer detect the
// terminal background themselves. Init has to ask, and Update has to
// restyle when the answer arrives - otherwise the dark defaults stay put
// and the list is close to unreadable on a light terminal.
func TestRestylesForALightTerminal(t *testing.T) {
	m, _ := newModel().Update(tea.WindowSizeMsg{Width: 80, Height: 24})

	dark := m.(model).View().Content

	light, _ := m.(model).Update(tea.BackgroundColorMsg{Color: lipgloss.White})
	if got := light.(model).View().Content; got == dark {
		t.Error("view is identical on a light and dark terminal; BackgroundColorMsg is not restyling anything")
	}
}

// --- release selection ---------------------------------------------
//
// These pin the rule that `update` installs THIS tool's releases. The
// bug they replace: /releases/latest answers "the newest release in
// this repository", so in a monorepo a CLI was offered a sibling's
// Android APK and failed with "no asset for darwin/arm64" - a message
// that blames the release rather than the question being wrong.

func testRelease(tag string, draft, pre bool, assets ...string) githubRelease {
	r := githubRelease{TagName: tag, Draft: draft, Prerelease: pre}
	for _, n := range assets {
		r.Assets = append(r.Assets, struct {
			Name               string `json:"name"`
			BrowserDownloadURL string `json:"browser_download_url"`
		}{Name: n, BrowserDownloadURL: "https://example.invalid/" + n})
	}
	return r
}

func TestASiblingsReleaseIsNotAnUpdate(t *testing.T) {
	if tagPrefix == "" {
		t.Skip("single-service repo: every release here is ours")
	}
	got := pickRelease([]githubRelease{
		testRelease("sibling/v9.9.9", false, false, "sibling.apk"),
		testRelease(tagPrefix+"v1.2.3", false, false, assetName()),
	})
	if got == nil || got.TagName != tagPrefix+"v1.2.3" {
		t.Fatalf("picked %v, want %sv1.2.3 - a sibling's release is not an update for us",
			got, tagPrefix)
	}
}

func TestTheNewestOfOursWins(t *testing.T) {
	got := pickRelease([]githubRelease{
		testRelease(tagPrefix+"v2.0.0", false, false, assetName()),
		testRelease(tagPrefix+"v1.0.0", false, false, assetName()),
	})
	if got == nil || got.TagName != tagPrefix+"v2.0.0" {
		t.Fatalf("picked %v, want the newest", got)
	}
}

// Releases cut before tags were namespaced are still installable.
// Stranding whoever is running one would be worse than the bug this
// fixes.
func TestLegacyUnprefixedReleasesStayReachable(t *testing.T) {
	if tagPrefix == "" {
		t.Skip("no prefix, so nothing is legacy")
	}
	got := pickRelease([]githubRelease{
		testRelease("v9.9.9", false, false, "somethingelse.apk"),
		testRelease("v0.1.2", false, false, assetName()),
	})
	if got == nil || got.TagName != "v0.1.2" {
		t.Fatalf("picked %v, want the untagged v0.1.2 that carries our asset", got)
	}
}

// /releases returns drafts and prereleases; /releases/latest did not.
func TestDraftsAndPrereleasesAreSkipped(t *testing.T) {
	got := pickRelease([]githubRelease{
		testRelease(tagPrefix+"v3.0.0", true, false, assetName()),
		testRelease(tagPrefix+"v2.9.0", false, true, assetName()),
		testRelease(tagPrefix+"v2.0.0", false, false, assetName()),
	})
	if got == nil || got.TagName != tagPrefix+"v2.0.0" {
		t.Fatalf("picked %v, want the newest fully-released version", got)
	}
}

// The prefix must not reach semver, or every release reads as a
// downgrade and `update` never offers anything.
func TestTheVersionComparedHasNoPrefix(t *testing.T) {
	if got := releaseVersion(tagPrefix + "v1.2.3"); got != "v1.2.3" {
		t.Errorf("releaseVersion(%q) = %q, want v1.2.3", tagPrefix+"v1.2.3", got)
	}
	if got := releaseVersion("v1.2.3"); got != "v1.2.3" {
		t.Errorf("releaseVersion(bare) = %q, want v1.2.3", got)
	}
}
