package main

// The interface itself. This is the file to edit.
//
// bubbletea v2, whose API differs from v1 examples online: Init returns
// only a tea.Cmd, View returns a tea.View, key presses arrive as
// tea.KeyPressMsg, and alt-screen is a field on the View instead of a
// program option. See UPGRADE_GUIDE_V2.md in the bubbletea module.

import (
	"charm.land/bubbles/v2/key"
	"charm.land/bubbles/v2/list"
	tea "charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
)

// item is one row. FilterValue is what `/` searches over.
type item struct {
	name string
	desc string
}

func (i item) Title() string       { return i.name }
func (i item) Description() string { return i.desc }
func (i item) FilterValue() string { return i.name }

// appStyle frames the whole interface; its padding is subtracted from the
// window size via GetFrameSize so hardcoding it in two places cannot drift.
var appStyle = lipgloss.NewStyle().Padding(1, 2)

type model struct {
	list list.Model
}

func newModel() model {
	items := []list.Item{
		item{name: "first", desc: "replace these with real data"},
		item{name: "second", desc: "see the Cmd note in Init"},
	}

	// Zero size: Bubble Tea delivers WindowSizeMsg before the first render,
	// so real dimensions arrive before anything is drawn. Dark styles
	// initially, replaced once the terminal answers RequestBackgroundColor.
	l := list.New(items, newDelegate(true), 0, 0)
	l.Title = "{{ .Name }}"

	// q is handled in Update, so the list would not mention it in help.
	l.AdditionalShortHelpKeys = func() []key.Binding {
		return []key.Binding{
			key.NewBinding(key.WithKeys("q"), key.WithHelp("q", "quit")),
		}
	}

	return model{list: l}
}

// newDelegate builds the row renderer; the delegate is created twice
// (startup and on BackgroundColorMsg) and the two must match.
func newDelegate(isDark bool) list.DefaultDelegate {
	d := list.NewDefaultDelegate()
	d.Styles = list.NewDefaultItemStyles(isDark)
	return d
}

// Init asks the terminal whether it is light or dark; Lip Gloss v2
// removed AdaptiveColor, so without asking the list keeps its dark
// defaults and is nearly unreadable on a light terminal.
func (m model) Init() tea.Cmd {
	return tea.RequestBackgroundColor
}

// Update must not block: anything slow belongs in a tea.Cmd.
func (m model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.BackgroundColorMsg:
		isDark := msg.IsDark()
		m.list.Styles = list.DefaultStyles(isDark)
		m.list.SetDelegate(newDelegate(isDark))
		return m, nil

	case tea.WindowSizeMsg:
		h, v := appStyle.GetFrameSize()
		m.list.SetSize(msg.Width-h, msg.Height-v)
		return m, nil

	case tea.KeyPressMsg:
		// While the filter is open every key belongs to it, or a name
		// containing "q" could not be typed.
		if m.list.FilterState() == list.Filtering {
			break
		}
		switch msg.String() {
		case "q", "ctrl+c":
			return m, tea.Quit
		}
	}

	var cmd tea.Cmd
	m.list, cmd = m.list.Update(msg)
	return m, cmd
}

// View is pure: no state changes, no I/O.
func (m model) View() tea.View {
	v := tea.NewView(appStyle.Render(m.list.View()))
	// In v2 AltScreen is a field on the View rather than a program option.
	v.AltScreen = true
	return v
}
