// {{ .Name }}
package main

// THIS WHOLE REPO IS YOURS. Nothing rewrites these files after `init`.
// Two couplings survive that:
//
//   - VERSION drives releases: CI publishes only when its first line
//     changes on main, tagging what it says.
//   - update.go downloads `{{ .Name }}_<os>_<arch>.tar.gz` from the
//     latest GitHub release; CI builds assets with exactly that name.
//     Rename either side and self-update fails.

import (
	"fmt"
	"os"

	tea "charm.land/bubbletea/v2"
	"github.com/spf13/cobra"
)

// Version is set at build time via ldflags; "dev" refuses to self-update.
var Version = "dev"

func rootCmd() *cobra.Command {
	root := &cobra.Command{
		Use:          "{{ .Name }}",
		Short:        "{{ .Name }}",
		SilenceUsage: true,
		Args:         cobra.NoArgs,
		// Bare `{{ .Name }}` starts the interface; without RunE cobra would
		// print help, which is right for a CLI and wrong here.
		RunE: func(_ *cobra.Command, _ []string) error {
			return run()
		},
	}
	root.AddCommand(updateCmd(), versionCmd())

	root.InitDefaultCompletionCmd()
	for _, c := range root.Commands() {
		if c.Name() == "completion" {
			c.AddCommand(completionInstallCmd("{{ .Name }}"))
		}
	}
	return root
}

// run is split from RunE so a test can build the model without a terminal.
func run() error {
	_, err := tea.NewProgram(newModel()).Run()
	return err
}

func versionCmd() *cobra.Command {
	return &cobra.Command{
		Use:   "version",
		Short: "print the version",
		Args:  cobra.NoArgs,
		Run: func(_ *cobra.Command, _ []string) {
			fmt.Println(Version)
		},
	}
}

func main() {
	if err := rootCmd().Execute(); err != nil {
		fmt.Fprintln(os.Stderr, "error:", err)
		os.Exit(1)
	}
}
