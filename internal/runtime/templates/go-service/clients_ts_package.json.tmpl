{
  "name": "@{{ .NPMScope }}/{{ .Name }}-client",
  "version": "{{ .SpecVersion }}",
  "description": "Typed client for the {{ .Name }} API, generated from its OpenAPI spec.",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./client": "./generated/client.gen.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+{{ .RepoURL }}.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "{{ .HeyAPIVersion }}",
    "typescript": "^5"
  }
}
