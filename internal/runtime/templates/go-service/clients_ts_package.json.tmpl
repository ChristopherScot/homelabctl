{
  "name": "@{{ .NPMScope }}/{{ .Name }}-client",
  "version": "{{ .SpecVersion }}",
  "description": "Typed client for the {{ .Name }} API, generated from its OpenAPI spec.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+{{ .RepoURL }}.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "{{ .HeyAPIVersion }}",
    "typescript": "^5"
  }
}
