# ogen instruments every operation with OpenTelemetry by default, which
# costs a consumer 13 modules and ~1.5MB of binary and produces spans
# that go nowhere unless a TracerProvider and collector exist. Turn this
# back on in the commit that adds one.
#
# Metrics and request logging come from our own middleware in server.go,
# keyed on the spec's operation IDs.
generator:
  features:
    disable:
      - 'ogen/otel'
