package main

// The seam. A service whose shape openapi cannot express (proxy,
// websocket, catch-all) replaces THIS file with a hand-written handler()
// and keeps main.go, api/client.go, the Dockerfile and every manifest.
//
// A replacement must:
//
//   - keep the signature `func handler() (http.Handler, error)`.
//   - serve /metrics itself, or deployment.yaml's scrape annotation
//     points at a 404.
//   - record to `requests` and `latency` below, or delete them: they are
//     registered at init, so ignoring them exports two permanently-empty
//     metric families and a dashboard on http_requests_total flatlines
//     instead of disappearing.

import (
	"context"
	"log/slog"
	"net/http"
	"os"
	"strconv"
	"strings"
	"time"

	"github.com/ogen-go/ogen/middleware"
	"github.com/prometheus/client_golang/prometheus"
	"github.com/prometheus/client_golang/prometheus/promauto"
	"github.com/prometheus/client_golang/prometheus/promhttp"
	"golang.org/x/mod/semver"

	"{{ .Module }}/api"
)

// Labelled by the spec's operation ID: ogen guarantees it is non-empty
// and it is bounded by the API, not by caller-controlled path segments.
var (
	requests = promauto.NewCounterVec(prometheus.CounterOpts{
		Name: "http_requests_total",
		Help: "Requests by operation, method and status.",
	}, []string{"operation", "method", "status"})

	latency = promauto.NewHistogramVec(prometheus.HistogramOpts{
		Name:    "http_request_duration_seconds",
		Help:    "Request latency by operation and method.",
		Buckets: prometheus.DefBuckets,
	}, []string{"operation", "method"})
)

// service implements the generated api.Handler.
type service struct{}

func (service) GetHealthz(context.Context) (*api.Health, error) {
	return &api.Health{Status: api.HealthStatusOk}, nil
}

func (service) GetRoot(context.Context) (*api.Identity, error) {
	return &api.Identity{Service: "{{ .Name }}", Version: version}, nil
}

// NewError renders a handler's error as the spec's Error schema AND logs
// it. ogen returns the error to the caller but does not log it.
//
// Identify the failing line by wrapping at the point it happens:
//
//	return nil, fmt.Errorf("fetching user %s: %w", id, err)
func (service) NewError(_ context.Context, err error) *api.ErrorStatusCode {
	slog.Error("handler failed", "err", err)

	return &api.ErrorStatusCode{
		StatusCode: http.StatusInternalServerError,
		Response:   api.Error{Message: err.Error()},
	}
}

// observe logs and measures every request that reaches a known operation.
// Unrouted requests are rejected by the generated router before this
// runs, so an arbitrary URL can never become a label.
func observe(req middleware.Request, next middleware.Next) (middleware.Response, error) {
	// The kubelet probes /healthz every few seconds; logging that buries
	// real traffic.
	if req.OperationID == "getHealthz" {
		return next(req)
	}

	start := time.Now()
	resp, err := next(req)

	status := strconv.Itoa(http.StatusOK)
	if err != nil {
		status = strconv.Itoa(http.StatusInternalServerError)
	}
	elapsed := time.Since(start)

	requests.WithLabelValues(req.OperationID, req.Raw.Method, status).Inc()
	latency.WithLabelValues(req.OperationID, req.Raw.Method).Observe(elapsed.Seconds())

	slog.Info("request",
		"method", req.Raw.Method,
		"operation", req.OperationID,
		"status", status,
		"client", clientName(req.Raw),
		"client_version", req.Raw.Header.Get(ClientVersionHeader),
		// Float milliseconds: elapsed.Milliseconds() truncates to int64
		// and a handler serving from memory logs duration_ms=0.
		"duration_ms", float64(elapsed.Nanoseconds())/1e6)
	return resp, err
}

// Header names the generated clients send. Declared here so the server
// does not depend on the client package to read its own requests.
// No X- prefix: RFC 6648 deprecated it in 2012.
const (
	ClientNameHeader    = "Client-Name"
	ClientVersionHeader = "Client-Version"
)

// minVersion is the oldest client this service answers, from MIN_VERSION.
// Empty means no floor. Read at startup rather than compiled in, so
// raising the floor is a config edit and a restart. If you drop this
// floor, also delete scaffold_floor_test.go.
var minVersion = os.Getenv("MIN_VERSION")

// tooOld reports whether a caller is below the floor. FAILS OPEN on
// unparseable versions and on a caller that sends no version - those are
// curl, probes and scripts, not the stale client this exists to stop.
//
// Clients report a bare semver (npm forbids the leading v), so add it
// here rather than expecting it on the wire.
func tooOld(r *http.Request) bool {
	if minVersion == "" {
		return false
	}
	got := r.Header.Get(ClientVersionHeader)
	if got == "" {
		return false
	}
	got, floor := "v"+got, "v"+strings.TrimPrefix(minVersion, "v")
	if !semver.IsValid(got) || !semver.IsValid(floor) {
		return false
	}
	return semver.Compare(got, floor) < 0
}

// clientName returns "unknown" rather than sniffing the user agent: an
// honest gap beats a confident wrong attribution.
func clientName(r *http.Request) string {
	if n := r.Header.Get(ClientNameHeader); n != "" {
		return n
	}
	return "unknown"
}

func handler() (http.Handler, error) {
	srv, err := api.NewServer(service{}, api.WithMiddleware(observe))
	if err != nil {
		return nil, err
	}
	mux := http.NewServeMux()
	mux.Handle("/metrics", promhttp.Handler())
	mux.Handle("/", refuseOldClients(srv))
	return mux, nil
}

// refuseOldClients turns away callers below the floor before the
// generated router sees them. Wrapped here rather than inside observe
// because ogen middleware returns (Response, error) and an error there
// routes through NewError and becomes a 500.
//
// /metrics is outside this: it is the platform's endpoint.
func refuseOldClients(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if tooOld(r) {
			// 410 Gone, not 429: generated clients retry 429 and 5xx and
			// nothing else, so 410 stops them dead.
			slog.Warn("refusing a client below the floor",
				"client", clientName(r),
				"client_version", r.Header.Get(ClientVersionHeader),
				"min_version", minVersion)
			http.Error(w, "this client is too old; reload or upgrade", http.StatusGone)
			return
		}
		next.ServeHTTP(w, r)
	})
}
