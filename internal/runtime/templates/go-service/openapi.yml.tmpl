# The API contract. `go generate` turns this into the server interface,
# request/response types, validation and a typed client; the compiler
# then refuses to build until the handlers match.
openapi: 3.0.3
info:
  title: {{ .Name }}
  # Bump on every API change; the generated client reports it in
  # Client-Version.
  version: {{ .SpecVersion }}
  description: {{ .Name }}, owned by {{ .Team }}.

paths:
  /healthz:
    get:
      operationId: getHealthz
      summary: Liveness and readiness probe.
      responses:
        '200':
          description: The service is up.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Health'
        default:
          description: Unexpected error.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /:
    get:
      operationId: getRoot
      summary: Identify the service and the running build.
      responses:
        '200':
          description: Service identity.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Identity'
        default:
          description: Unexpected error.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:
  schemas:
    Health:
      type: object
      required: [status]
      properties:
        status:
          type: string
          enum: [ok]

    Identity:
      type: object
      required: [service, version]
      properties:
        service:
          type: string
        version:
          type: string

    # A `default` response with this shape lets ogen generate convenient
    # errors: a handler can return a plain error rather than every
    # operation defining its own error union.
    Error:
      type: object
      required: [message]
      properties:
        message:
          type: string
