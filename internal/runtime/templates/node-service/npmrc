# Refuse to install under a node older than package.json declares,
# rather than warning and carrying on.
#
# npm writes optional dependencies' "libc" fields from node 24 and
# strips them on older ones, so an install with the wrong node silently
# rewrites package-lock.json - deletions in a file nobody edited, which
# CI then puts back on its next run. The lockfile churns between the two
# forever and every diff carries noise.
#
# CI pins node 24 (steps.yaml), so this is what makes a local install
# agree with it. Without it, "engines" is a comment.
engine-strict=true
