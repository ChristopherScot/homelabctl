// The typed client for this service. api/ is committed, so a Go consumer
// installs it with `go get github.com/<owner>/{{ .Name }}@<tag>`.
//
// ogen ships no retries, timeout or breaker. Its only extension point is
// WithClient, so those live here - defaults chosen for effect on the
// SYSTEM (one retry, not five: five can mean five times the traffic to
// something already struggling).
//
//	c, err := api.New(url, api.HTTPOptions{})

// ClientVersion tracks the spec's info.version and is sent on every
// request so a server can see which client versions still call it.
const ClientVersion = "{{ .Version }}"

// No X- prefix: RFC 6648 deprecated it in 2012.
const ClientVersionHeader = "Client-Version"

// ClientNameHeader carries HTTPOptions.Name - WHICH service is calling,
// where Client-Version says which version of the spec it was built
// against. Without both, a runaway client cannot be attributed.
const ClientNameHeader = "Client-Name"

// RetryPolicy decides whether a failed request is worth repeating and
// how long to wait. The length of Backoffs is the retry count.
type RetryPolicy interface {
	Backoffs() []time.Duration
	Retry(req *http.Request, resp *http.Response, err error) bool
}

// SingleRetry retries once, a second later. The default.
type SingleRetry struct{}

func (SingleRetry) Backoffs() []time.Duration { return []time.Duration{time.Second} }
func (SingleRetry) Retry(req *http.Request, resp *http.Response, err error) bool {
	return retryable(req, resp, err)
}

// ExponentialRetry backs off with jitter for a slow-but-not-broken
// dependency. Reach for it deliberately: five attempts can still mean
// five times the load.
type ExponentialRetry struct{}

func (ExponentialRetry) Backoffs() []time.Duration {
	out := make([]time.Duration, 5)
	next := 100 * time.Millisecond
	for i := range out {
		// Jitter, so a fleet of callers does not retry in lockstep and
		// arrive as one synchronised wave.
		out[i] = next + time.Duration((rand.Float64()*2-1)*0.25*float64(next))
		next *= 2
	}
	return out
}
func (ExponentialRetry) Retry(req *http.Request, resp *http.Response, err error) bool {
	return retryable(req, resp, err)
}

// NoRetry is for a caller that would rather fail fast.
type NoRetry struct{}

func (NoRetry) Backoffs() []time.Duration                       { return nil }
func (NoRetry) Retry(*http.Request, *http.Response, error) bool { return false }

// retryable repeats only what is safe to repeat: a POST may already have
// applied, so retrying it can create a second thing.
func retryable(req *http.Request, resp *http.Response, err error) bool {
	switch req.Method {
	case http.MethodGet, http.MethodHead, http.MethodOptions, http.MethodPut, http.MethodDelete:
	default:
		return false
	}
	// A body we cannot rewind cannot be sent twice. net/http fills in
	// GetBody for the readers it knows - strings.Reader, bytes.Reader,
	// bytes.Buffer - and http.Client.Do replays from it, which is why
	// an ordinary PUT retries correctly. A caller that hands over an
	// opaque io.Reader gets no GetBody, and a second attempt would
	// send an empty body under the original Content-Length.
	if req.Body != nil && req.Body != http.NoBody && req.GetBody == nil {
		return false
	}
	if err != nil {
		return true
	}
	// Same carve-out the breaker makes: a permanently unimplemented
	// route does not become implemented on the next attempt, so
	// retrying it only spends the budget.
	if permanentProtocolError(resp.StatusCode) {
		return false
	}
	return resp.StatusCode == http.StatusTooManyRequests || resp.StatusCode >= 500
}

// outcome is what one request says about the service's health.
//
// Three values, not two: "this tells us nothing" is different from
// "this went fine". A breaker that treats them alike lets an ignored
// outcome ERASE a run of real failures - a service answering 500 on
// one route and 501 on another never trips, because each 501 zeroes
// the count the 500s built up.
//
// sony/gobreaker draws the same three-way line: onSuccess clears
// ConsecutiveFailures, onFailure increments it, and onExclusion
// touches neither. Its exclusions are opt-in and keyed on errors
// rather than status codes, because it wraps more than HTTP; this
// client only speaks HTTP, and four consumers should not each have
// to re-derive which statuses mean the service is unwell.
type outcome int

const (
	// healthy: the service answered, and the answer was fine.
	healthy outcome = iota
	// unwell: evidence the SERVICE is in trouble.
	unwell
	// ignore: neither. The caller gave up, or the answer was a
	// permanent statement about the request rather than the service.
	ignore
)

// classify says what one request's outcome tells us about the
// service, which is the only thing a breaker should count.
//
// Two things look like failures and are not:
//
// A cancelled or timed-out request says the caller changed its mind.
// Counting those meant three impatient taps in a CLI or a phone app
// opened the circuit against a server that was answering fine.
//
// 501 and 505 are permanent protocol answers. The route is not
// implemented, or the version is not spoken; neither recovers after
// a cooldown, so counting them leaves the breaker flapping open
// forever against a service that is working exactly as built.
func classify(req *http.Request, resp *http.Response, err error) outcome {
	// Whose deadline expired? Our own per-attempt Timeout surfaces as
	// context.DeadlineExceeded too, and a service too slow to answer
	// within it IS unwell - that is a case the breaker exists for. So
	// the question is not what the error says, it is whether the
	// CALLER's context is still alive. If it is, the clock that ran
	// out was ours.
	if err != nil && req.Context().Err() != nil {
		return ignore
	}
	if err != nil {
		return unwell
	}
	if resp == nil {
		// Unreachable: http.Client.Do returns one or the other.
		// Stated rather than asserted, so a future path out of the
		// loop gets this instead of a silent "healthy".
		return ignore
	}
	if permanentProtocolError(resp.StatusCode) {
		return ignore
	}
	if resp.StatusCode >= http.StatusInternalServerError {
		return unwell
	}
	return healthy
}

// permanentProtocolError reports whether a 5xx is a permanent
// statement about THIS REQUEST rather than evidence about the
// service's health: the route is not implemented (501), or the HTTP
// version is not spoken (505). Neither changes after a cooldown, so
// neither is worth a retry and neither belongs in the breaker's
// count.
func permanentProtocolError(status int) bool {
	return status == http.StatusNotImplemented || status == http.StatusHTTPVersionNotSupported
}

// ErrCircuitOpen fails a caller immediately rather than queueing it
// behind a timeout it is going to hit anyway.
var ErrCircuitOpen = errors.New("circuit open")

// Breaker trips after FailedRequests consecutive failures and lets
// one request through every Cooldown to probe recovery.
type Breaker struct {
	// FailedRequests is how many consecutive failed REQUESTS open the
	// circuit. A request that exhausted its retries counts once.
	//
	// Zero lets everything through rather than opening immediately:
	// a Breaker nobody configured should not refuse traffic. Leave
	// Breaker nil on HTTPOptions to disable circuit breaking; this
	// field is for choosing where the circuit trips.
	//
	// The TypeScript client deliberately does the opposite - its
	// `new Breaker()` takes constructor defaults and opens after 5 -
	// because a constructor can carry a default and a zero value
	// cannot. Both are tested. Do not "fix" either to match.
	FailedRequests int
	Cooldown       time.Duration

	mu       sync.Mutex
	failures int
	openedAt time.Time
	// probing is true while one caller is through the half-open gate
	// and has not reported back. Without it every caller waiting out
	// the cooldown is released at once - which is the stampede the
	// breaker exists to stop, aimed at a dependency that has just
	// proved it is struggling.
	probing bool
}

func (b *Breaker) allow() bool {
	b.mu.Lock()
	defer b.mu.Unlock()
	if b.failures < b.FailedRequests {
		return true
	}
	// Open. One caller past the cooldown gets through to find out
	// whether the dependency is back; everyone else waits for its
	// verdict rather than joining it.
	if !b.probing && time.Since(b.openedAt) > b.Cooldown {
		b.probing = true
		return true
	}
	return false
}

// record is the other half of allow. It takes the probe slot back if
// this request held it, updates the failure run, and re-arms the
// cooldown when the circuit is open and this request did not prove
// recovery.
func (b *Breaker) record(o outcome) {
	b.mu.Lock()
	defer b.mu.Unlock()

	probe := b.probing
	b.probing = false

	// Each outcome declares what it PROVED, and the clock below reads
	// those rather than the outcome's name. An outcome added later
	// has to say so to count as recovery or as a failure, and
	// silence gets the conservative answer on both.
	//
	// Keyed on the name instead, a second success-like outcome would
	// arm the clock on a breaker that had just recovered, and a
	// failure-like one would extend the run without moving the
	// cooldown - which is the early-expiry bug the >= below exists
	// to prevent, arriving from the other side.
	recovered, extended := false, false
	switch o {
	case healthy:
		b.failures = 0
		recovered = true
	case unwell:
		b.failures++
		extended = true
	case ignore:
		// Tells us nothing, so the run stands: neither extended nor
		// cleared.
	}

	// A probe that did not prove recovery spends its slot and costs a
	// full cooldown. Without this an open circuit hands a fresh probe
	// to every caller the moment the first one reports back.
	if probe && !recovered {
		b.openedAt = time.Now()
		return
	}

	// A failure moves the clock so the cooldown is measured from the
	// last one rather than the first.
	//
	// >= not ==: requests already in flight when the breaker tripped
	// land afterwards, and with == their failures would not move it,
	// so the cooldown would expire early.
	if extended && b.failures >= b.FailedRequests {
		b.openedAt = time.Now()
	}
}

// HTTPOptions configure the client. The zero value is the default set.
type HTTPOptions struct {
	// Timeout bounds one attempt; zero means 5s and a retry gets its own.
	Timeout time.Duration
	// Policy defaults to SingleRetry.
	Policy RetryPolicy
	// Breaker is optional; nil disables circuit breaking.
	Breaker *Breaker

	// MaxRetryAfter caps how long a server's Retry-After can park this
	// client. Zero means 30s. A server may answer with an hour, and
	// sleeping that long inside a request looks exactly like a hang.
	MaxRetryAfter time.Duration

	// Name is the CALLER's own service name, sent as Client-Name. Empty
	// records the caller as unknown, which is honest; guessing from the
	// user agent would put a confident wrong answer in the logs.
	Name string
}

// HTTPClient satisfies ogen's ht.Client.
type HTTPClient struct {
	http          *http.Client
	policy        RetryPolicy
	breaker       *Breaker
	maxRetryAfter time.Duration
	name          string
}

var _ ht.Client = (*HTTPClient)(nil)

func NewHTTPClient(o HTTPOptions) *HTTPClient {
	if o.Timeout == 0 {
		o.Timeout = 5 * time.Second
	}
	if o.Policy == nil {
		o.Policy = SingleRetry{}
	}
	if o.MaxRetryAfter == 0 {
		o.MaxRetryAfter = 30 * time.Second
	}
	return &HTTPClient{
		http:          &http.Client{Timeout: o.Timeout},
		policy:        o.Policy,
		breaker:       o.Breaker,
		maxRetryAfter: o.MaxRetryAfter,
		name:          o.Name,
	}
}

// New is the constructor a caller should reach for: it installs the
// resilience above, so the zero HTTPOptions gives a 5s timeout, one
// retry on idempotent methods, and Retry-After obeyed.
//
//	c, err := api.New(url, api.HTTPOptions{})
//	c, err := api.New(url, api.HTTPOptions{Policy: api.ExponentialRetry{}})
//
// NewClient, which ogen generates, installs none of it - its default
// is http.DefaultClient, which has NO timeout. It stays reachable for
// a caller that wants a different transport entirely, but it is not
// the one to reach for.
func New(serverURL string, o HTTPOptions{{ if .HasSecurity }}, sec SecuritySource{{ end }}) (*Client, error) {
	return NewClient(serverURL, {{ if .HasSecurity }}sec, {{ end }}WithClient(NewHTTPClient(o)))
}

// retryAfter reads the server's own answer. RFC 9110 allows either a
// delay in seconds or an HTTP-date, and servers send both in the wild.
// Capped so an hour-long value cannot masquerade as a hang.
// retryAfter reads the server's own answer. The third result says
// the server asked for longer than max: the caller must give up
// rather than substitute a shorter wait of its own.
func retryAfter(resp *http.Response, max time.Duration) (wait time.Duration, ok bool, tooLong bool) {
	if resp == nil {
		return 0, false, false
	}
	v := resp.Header.Get("Retry-After")
	if v == "" {
		return 0, false, false
	}

	var d time.Duration
	if secs, err := strconv.Atoi(strings.TrimSpace(v)); err == nil {
		if secs < 0 {
			return 0, false, false
		}
		d = time.Duration(secs) * time.Second
	} else if t, err := http.ParseTime(v); err == nil {
		d = time.Until(t)
		if d < 0 {
			d = 0
		}
	} else {
		return 0, false, false
	}

	// Longer than we are willing to wait means STOP, not "ignore the
	// header". Returning false here sent the caller back to the
	// policy's own backoff, so a server asking for an hour was
	// retried in a second - the opposite of what it asked for, at the
	// moment it was most emphatic. maxRetryAfter is a bound on our
	// patience, not a filter on the server's answer.
	if d > max {
		return 0, false, true
	}
	return d, true, false
}

func (c *HTTPClient) Do(req *http.Request) (*http.Response, error) {
	if c.breaker != nil && !c.breaker.allow() {
		return nil, ErrCircuitOpen
	}
	req.Header.Set(ClientVersionHeader, ClientVersion)
	if c.name != "" {
		req.Header.Set(ClientNameHeader, c.name)
	}

	backoffs := c.policy.Backoffs()
	var (
		resp *http.Response
		err  error
	)

	// Deferred so that EVERY exit reports back, including the
	// cancellation return below. allow() hands out the half-open
	// probe and only record() takes it back: a probe that returns
	// without reporting leaves the breaker believing it is still out
	// there, and allow() then refuses everyone for good. Wedged
	// closed is worse than the stampede it replaced, because it does
	// not heal.
	if c.breaker != nil {
		defer func() { c.breaker.record(classify(req, resp, err)) }()
	}

	for attempt := 0; ; attempt++ {
		resp, err = c.http.Do(req)
		if attempt >= len(backoffs) || !c.policy.Retry(req, resp, err) {
			break
		}

		// The server's Retry-After wins: it knows when capacity returns.
		wait := backoffs[attempt]
		d, ok, tooLong := retryAfter(resp, c.maxRetryAfter)
		if tooLong {
			// It asked for longer than we will wait. Hand the
			// response back rather than retrying sooner than it said.
			break
		}
		if ok {
			wait = d
		}

		// Drain and close so the connection returns to the pool reusable.
		if resp != nil {
			_, _ = io.Copy(io.Discard, resp.Body)
			resp.Body.Close()
		}

		// Wait, but not past the caller's deadline. time.Sleep would
		// park this goroutine for the server's full Retry-After - up
		// to maxRetryAfter - after the caller has already given up,
		// and return an answer nobody is waiting for.
		timer := time.NewTimer(wait)
		select {
		case <-req.Context().Done():
			timer.Stop()
			// Named results, so the deferred record() sees the
			// cancellation rather than the last response.
			resp, err = nil, req.Context().Err()
			return resp, err
		case <-timer.C:
		}
	}
	return resp, err
}
