// A fetch that answers from a script and records what it was asked.
// Deliberately not a real server: these are transport tests, and a
// loopback listener buys nothing here but flakiness and teardown.
function stub(
  answers: Array<Response | Error | ((req: Request) => Response | Error)>
) {
  const seen: Request[] = []
  let i = 0
  const fetch = async (input: RequestInfo | URL, init?: RequestInit) => {
    const req = new Request(input, init)
    seen.push(req)
    // Honour the signal: a stub that resolves regardless cannot show
    // that the timeout or the caller's abort reached the attempt.
    const sig = init?.signal
    if (sig?.aborted === true) throw sig.reason
    const answer = answers[Math.min(i++, answers.length - 1)]
    const r = typeof answer === 'function' ? answer(req) : answer
    if (r instanceof Error) throw r
    return r.clone()
  }
  return { fetch, seen, get count() { return seen.length } }
}

// Installs a stub as globalThis.fetch for one test and restores it.
// createResilientFetch closes over the global, which is the seam a
// consumer gets too.
function withFetch<T>(s: { fetch: any }, fn: () => Promise<T>): Promise<T> {
  const real = globalThis.fetch
  globalThis.fetch = s.fetch
  return fn().finally(() => {
    globalThis.fetch = real
  })
}

// Bounds a wait that is only supposed to be short.
//
// Every "does not wait" assertion here has the same failure mode: with
// the bug present the promise does not settle, so a plain await waits
// as long as the bug says to - an hour, for the Retry-After cap. The
// harness passes --test-timeout, which does report such a test as
// timed out, but it reports it at the timeout rather than at the
// second the bug is provable, and it does not end the run: node then
// sits on the pending timer until the harness's own deadline kills it.
//
// So race the work against a timer here. The test fails in a second
// with a message naming the cause, which is the line someone reads
// first.
function within<T>(ms: number, what: string, p: Promise<T>): Promise<T> {
  return Promise.race([
    p,
    new Promise<never>((_r, rej) =>
      setTimeout(() => rej(new Error(`still waiting after ${ms}ms: ${what}`)), ms).unref(),
    ),
  ])
}

const ok = () => new Response('{}', { status: 200 })
const fail = (status: number) => () => new Response('', { status })

test('the client identifies itself', async () => {
  const s = stub([ok()])
  await withFetch(s, async () => {
    await createResilientFetch({ name: 'caller' })('https://x/thing')
  })
  assert.equal(s.seen[0].headers.get(ClientVersionHeader), ClientVersion)
  assert.equal(s.seen[0].headers.get(ClientNameHeader), 'caller')
})

test('Client-Name is omitted when the caller did not name itself', async () => {
  const s = stub([ok()])
  await withFetch(s, async () => {
    await createResilientFetch()('https://x/thing')
  })
  assert.equal(s.seen[0].headers.get(ClientNameHeader), null)
})

test('an idempotent request is retried once by default', async () => {
  const s = stub([fail(503), ok()])
  const res = await withFetch(s, () =>
    createResilientFetch({ policy: { backoffs: () => [0], retry: singleRetry.retry } })(
      'https://x/thing'
    )
  )
  assert.equal(res.status, 200)
  assert.equal(s.count, 2)
})

test('a POST is never retried', async () => {
  const s = stub([fail(503), ok()])
  const res = await withFetch(s, () =>
    createResilientFetch({ policy: { backoffs: () => [0], retry: singleRetry.retry } })(
      'https://x/thing',
      { method: 'POST', body: 'x' }
    )
  )
  assert.equal(res.status, 503)
  assert.equal(s.count, 1, 'a POST may already have applied')
})

test('a retried request resends its body', async () => {
  const s = stub([
    () => new Response('', { status: 503 }),
    () => new Response('', { status: 200 }),
  ])
  // Read the bodies off the recorded requests rather than inside the
  // stub: clone() is what makes the replay work, and reading there
  // would consume the stream the client is about to send.
  await withFetch(s, () =>
    createResilientFetch({ policy: { backoffs: () => [0], retry: singleRetry.retry } })(
      'https://x/thing',
      { method: 'PUT', body: 'payload' }
    )
  )
  assert.equal(s.count, 2)
  assert.deepEqual(
    await Promise.all(s.seen.map((r) => r.clone().text())),
    ['payload', 'payload'],
    'the second attempt sent an empty body: the request was not replayed'
  )
})

test('a transport failure is retried', async () => {
  const s = stub([new TypeError('connection refused'), ok()])
  const res = await withFetch(s, () =>
    createResilientFetch({ policy: { backoffs: () => [0], retry: singleRetry.retry } })(
      'https://x/thing'
    )
  )
  assert.equal(res.status, 200)
  assert.equal(s.count, 2)
})

test('noRetry makes exactly one attempt', async () => {
  const s = stub([fail(503)])
  const res = await withFetch(s, () =>
    createResilientFetch({ policy: noRetry })('https://x/thing')
  )
  assert.equal(res.status, 503)
  assert.equal(s.count, 1)
})

test('exponentialRetry actually backs off', () => {
  const b = exponentialRetry.backoffs()
  assert.equal(b.length, 5)
  for (let i = 1; i < b.length; i++) {
    assert.ok(
      b[i] > b[i - 1],
      `backoff ${i} (${b[i]}) did not grow past ${b[i - 1]}`
    )
  }
  // Jittered, so two calls must not agree. Without jitter a fleet of
  // callers retries in lockstep.
  assert.notDeepEqual(exponentialRetry.backoffs(), b)
})

test('Retry-After beats the policy backoff', async () => {
  const s = stub([
    () => new Response('', { status: 503, headers: { 'retry-after': '0' } }),
    ok(),
  ])
  const started = Date.now()
  await within(
    1000,
    'the client waited its own backoff instead of the 0s the server asked for',
    withFetch(s, () =>
      createResilientFetch({
        policy: { backoffs: () => [10_000], retry: singleRetry.retry },
      })('https://x/thing')
    )
  )
  assert.equal(s.count, 2)
  assert.ok(
    Date.now() - started < 1000,
    'waited the policy backoff instead of the 0s the server asked for'
  )
})

test('Retry-After is read in seconds', () => {
  const res = new Response('', { headers: { 'retry-after': '2' } })
  assert.deepEqual(retryAfterMs(res, 30_000), { ms: 2000, tooLong: false })
})

test('Retry-After accepts an HTTP-date', () => {
  const when = new Date(Date.now() + 2000).toUTCString()
  const got = retryAfterMs(new Response('', { headers: { 'retry-after': when } }), 30_000)
  assert.equal(got.tooLong, false)
  assert.ok(
    got.ms !== undefined && got.ms > 500 && got.ms <= 2000,
    `a date two seconds out gave ${got.ms}ms`
  )
})

test('an unparseable Retry-After falls back to the policy', () => {
  assert.deepEqual(
    retryAfterMs(new Response('', { headers: { 'retry-after': 'soon' } }), 30_000),
    { tooLong: false }
  )
})

test('a negative Retry-After falls back to the policy', () => {
  assert.deepEqual(
    retryAfterMs(new Response('', { headers: { 'retry-after': '-5' } }), 30_000),
    { tooLong: false }
  )
})

test('a too-long Retry-After stops rather than retrying sooner', async () => {
  const s = stub([
    () => new Response('', { status: 503, headers: { 'retry-after': '3600' } }),
    ok(),
  ])
  const started = Date.now()
  const res = await within(
    1000,
    'the client honoured a 3600s Retry-After instead of giving up',
    withFetch(s, () =>
      createResilientFetch({
        policy: { backoffs: () => [0], retry: singleRetry.retry },
        maxRetryAfterMs: 30_000,
      })('https://x/thing')
    )
  )
  // Not retried a second later: an hour is the server at its most
  // emphatic, and coming back in 1s is the opposite of what it asked.
  assert.equal(s.count, 1)
  assert.equal(res.status, 503)
  assert.ok(Date.now() - started < 1000)
})

test('a permanent protocol error is not retried', async () => {
  for (const status of [501, 505]) {
    const s = stub([fail(status), ok()])
    const res = await withFetch(s, () =>
      createResilientFetch({ policy: { backoffs: () => [0], retry: singleRetry.retry } })(
        'https://x/thing'
      )
    )
    assert.equal(s.count, 1, `${status} was retried`)
    assert.equal(res.status, status)
  }
})

test('the caller giving up cuts the backoff short', async () => {
  const s = stub([fail(503), ok()])
  const caller = AbortSignal.abort(new Error('caller gave up'))
  const started = Date.now()
  await assert.rejects(() =>
    within(
      1000,
      'the backoff outlived the caller that had already given up',
      withFetch(s, () =>
        createResilientFetch({
          policy: { backoffs: () => [30_000], retry: singleRetry.retry },
        })('https://x/thing', { signal: caller })
      )
    )
  )
  assert.ok(
    Date.now() - started < 1000,
    'slept the full backoff on behalf of a caller that had gone'
  )
})

// --- the breaker ------------------------------------------------

test('the breaker opens after failedRequests consecutive failures', () => {
  const b = new Breaker(2, 30_000)
  assert.equal(b.allow(), true)
  b.record('unwell')
  assert.equal(b.allow(), true)
  b.record('unwell')
  assert.equal(b.allow(), false, 'two failures should have opened it')
})

test('an open circuit rejects without reaching the dependency', async () => {
  const b = new Breaker(1, 30_000)
  b.allow()
  b.record('unwell')

  const s = stub([ok()])
  await assert.rejects(
    () => withFetch(s, () => createResilientFetch({ breaker: b })('https://x/thing')),
    CircuitOpenError
  )
  assert.equal(s.count, 0, 'the request reached a dependency behind an open circuit')
})

test('a success clears the failure run', () => {
  const b = new Breaker(3, 30_000)
  b.allow(); b.record('unwell')
  b.allow(); b.record('unwell')
  b.allow(); b.record('healthy')
  b.allow(); b.record('unwell')
  b.allow(); b.record('unwell')
  assert.equal(b.allow(), true, 'the success did not clear the earlier failures')
})

test('an ignored outcome does not erase real failures', () => {
  // A service answering 500 on one route and 501 on another: if the
  // ignore zeroed the count, the breaker would never trip.
  const b = new Breaker(3, 30_000)
  for (let i = 0; i < 3; i++) {
    b.allow(); b.record('unwell')
    b.allow(); b.record('ignore')
  }
  assert.equal(b.allow(), false, 'the interleaved ignores erased the failures')
})

test('half-open releases exactly one probe', async () => {
  const b = new Breaker(1, 0)
  b.allow(); b.record('unwell')
  await new Promise((r) => setTimeout(r, 5))
  assert.equal(b.allow(), true, 'the cooldown passed and no probe was released')
  assert.equal(b.allow(), false, 'a second probe went out while the first was in flight')
})

test('a failed probe re-arms the cooldown', async () => {
  // failedRequests is 2 and only one failure is banked, so the
  // failure-run guard cannot be what re-arms the clock here - the
  // probe is. With failedRequests of 1 both guards fire and the test
  // passes whichever one is doing the work, which is a test that
  // cannot fail for the reason it is named after.
  const b = new Breaker(2, 50)
  b.allow(); b.record('unwell')
  b.allow(); b.record('unwell')
  assert.equal(b.allow(), false, 'two failures should have opened it')

  await new Promise((r) => setTimeout(r, 60))
  assert.equal(b.allow(), true, 'the cooldown passed and no probe was released')

  // The probe succeeds enough to clear the run but not to close the
  // circuit - there is no such outcome, so use the one that proves
  // nothing. A probe reporting `ignore` holds the circuit open and
  // must spend a full cooldown doing it.
  b.record('ignore')
  assert.equal(b.allow(), false, 'the spent probe did not cost a fresh cooldown')
  await new Promise((r) => setTimeout(r, 60))
  assert.equal(b.allow(), true, 'the circuit never offered another probe')
})

test('a successful probe closes the circuit', async () => {
  const b = new Breaker(1, 0)
  b.allow(); b.record('unwell')
  await new Promise((r) => setTimeout(r, 5))
  assert.equal(b.allow(), true)
  b.record('healthy')
  assert.equal(b.allow(), true)
  assert.equal(b.allow(), true, 'the circuit did not close after a healthy probe')
})

test('an ignored probe still costs a cooldown', async () => {
  // Otherwise an open circuit hands a fresh probe to every caller the
  // moment the first reports back with nothing to say.
  const b = new Breaker(1, 50)
  b.allow(); b.record('unwell')
  await new Promise((r) => setTimeout(r, 60))
  assert.equal(b.allow(), true)
  b.record('ignore')
  assert.equal(b.allow(), false, 'the open circuit is not throttling probes')
})

test('an ignored non-probe does not delay recovery', async () => {
  // Requests already in flight when the breaker tripped land
  // afterwards. One of those reporting `ignore` holds no probe, so it
  // must not push the cooldown out.
  const b = new Breaker(1, 50)
  b.allow(); b.record('unwell')
  await new Promise((r) => setTimeout(r, 30))
  b.record('ignore')
  await new Promise((r) => setTimeout(r, 30))
  assert.equal(b.allow(), true, 'the stray ignore re-armed the cooldown')
})

test('a cancelled request does not wedge the breaker', async () => {
  // allow() hands out the probe and only record() takes it back. A
  // probe that leaves without reporting leaves the breaker believing
  // it is still in flight, and it then refuses everyone for good.
  const b = new Breaker(1, 0)
  const s = stub([new DOMException('aborted', 'AbortError')])
  await assert.rejects(() =>
    withFetch(s, () =>
      createResilientFetch({ breaker: b, policy: noRetry })('https://x/thing', {
        signal: AbortSignal.abort(),
      })
    )
  )
  await new Promise((r) => setTimeout(r, 5))
  assert.equal(b.allow(), true, 'the breaker is wedged: it never got its probe back')
})

test('cancellation is not a dependency failure', async () => {
  const b = new Breaker(1, 30_000)
  const s = stub([new DOMException('aborted', 'AbortError')])
  await assert.rejects(() =>
    withFetch(s, () =>
      createResilientFetch({ breaker: b, policy: noRetry })('https://x/thing', {
        signal: AbortSignal.abort(),
      })
    )
  )
  assert.equal(b.allow(), true, 'the caller changing its mind counted against the service')
})

test('a hung dependency trips the breaker', async () => {
  // A timeout IS evidence the service is unwell - it is the case the
  // breaker exists for - even though it arrives as an abort.
  const b = new Breaker(1, 30_000)
  const s = {
    fetch: (_i: any, init?: RequestInit) =>
      new Promise((_res, rej) => {
        init?.signal?.addEventListener('abort', () => rej(init.signal!.reason), {
          once: true,
        })
      }),
  }
  await assert.rejects(() =>
    withFetch(s, () =>
      createResilientFetch({ breaker: b, policy: noRetry, timeoutMs: 20 })('https://x/thing')
    )
  )
  assert.equal(b.allow(), false, 'a dependency that never answers did not trip the breaker')
})

test('a server error trips the breaker but a client error does not', () => {
  const server = new Breaker(1, 30_000)
  server.allow(); server.record('unwell')
  assert.equal(server.allow(), false)

  const client = new Breaker(1, 30_000)
  client.allow(); client.record('healthy')
  assert.equal(client.allow(), true, 'a 4xx is an answer, not a sick service')
})

test('a permanent protocol error is not a dependency failure', async () => {
  for (const status of [501, 505]) {
    const b = new Breaker(1, 30_000)
    const s = stub([fail(status)])
    await withFetch(s, () =>
      createResilientFetch({ breaker: b, policy: noRetry })('https://x/thing')
    )
    assert.equal(b.allow(), true, `${status} counted against the service`)
  }
})

test('a zero-valued breaker still opens on its defaults', () => {
  // The defaults are a real policy, not "disabled": five failed
  // requests, thirty seconds. A consumer that writes `new Breaker()`
  // gets breaking, and finding that out here is cheaper than in prod.
  const b = new Breaker()
  assert.equal(b.failedRequests, 5)
  assert.equal(b.cooldownMs, 30_000)
  for (let i = 0; i < 5; i++) {
    assert.equal(b.allow(), true, `refused request ${i + 1} of 5`)
    b.record('unwell')
  }
  assert.equal(b.allow(), false)
})

test('omitting the breaker disables breaking', async () => {
  const s = stub([fail(503)])
  for (let i = 0; i < 10; i++) {
    const res = await withFetch(s, () =>
      createResilientFetch({ policy: noRetry })('https://x/thing')
    )
    assert.equal(res.status, 503)
  }
  assert.equal(s.count, 10, 'something started refusing without a breaker configured')
})
