{{ header `//` }}// Resilience for the {{ .Name }} client: timeout, retry, circuit
// breaker and the identifying headers. The transport defaults match
// the Go client in api/client.go - 5s timeout, one retry (five can
// mean five times the traffic to something already struggling) - and
// both clients failing the same way is the point.
//
// The ONE place they differ is an unconfigured Breaker, and it is a
// difference in the languages rather than a decision. `new Breaker()`
// here takes the constructor defaults and opens after 5 failures; Go's
// `&Breaker{}` has FailedRequests of 0 and lets everything through,
// because a zero value cannot carry a default and a Breaker nobody
// configured should not refuse traffic. Neither side is wrong for its
// language, and both are tested; what would be wrong is assuming the
// other one matches. Omit `breaker` (nil, in Go) to disable breaking
// in either.
//
//   import { createClient, listThings } from '{{ .ImportPath }}'
//   const client = createClient({ baseUrl: 'https://{{ .Name }}' })
//   const { data, error } = await listThings({ client })
//
// EVERYTHING BELOW IS GENERATOR-AGNOSTIC. It wraps `fetch` and knows
// nothing about how the operations were generated. Swapping the
// generator means changing the import and the one adapter call at the
// bottom of this file - the Go client keeps the same seam, where
// HTTPClient satisfies the generator's transport interface and the
// retry logic is plain net/http.
// /index.ts, not .ts: generated/client is a DIRECTORY, so a published
// client names its entry file where the others name themselves.
import { createClient as createGeneratedClient, createConfig } from './generated/client{{ if .Published }}/index.ts{{ end }}'

{{ if .Published }}// Read from package.json rather than hardcoded: the header cannot then
// disagree with the version a consumer installed, which is the one
// that matters once this is on npm.
import pkg from './package.json' with { type: 'json' }

export const ClientVersion: string = pkg.version{{ else }}// Written in: this client ships inside the repo that generated it and
// has no package.json to read. The value is the version of THEIR API
// the spec declared, which is what a server reading Client-Version
// wants to know.
export const ClientVersion = '{{ .Version }}'{{ end }}
export const ClientVersionHeader = 'Client-Version'

// Set via createClient({ name: 'my-service' }); No X- prefix on either:
// RFC 6648 deprecated it in 2012.
export const ClientNameHeader = 'Client-Name'

export interface RetryPolicy {
  backoffs(): number[]
  retry(req: Request, res: Response | undefined, err: unknown): boolean
}

export interface ClientOptions {
  baseUrl: string
  /** The CALLER's own service name, sent as Client-Name so a runaway
   *  client can be attributed. */
  name?: string
  /** Bounds a single attempt. Default 5000; a retry gets its own. */
  timeoutMs?: number
  /** Default singleRetry. */
  policy?: RetryPolicy
  /** Omit to disable circuit breaking. */
  breaker?: Breaker
  /** Bounds Retry-After. Default 30000. */
  maxRetryAfterMs?: number
}

/** What one request says about the service's health.
 *
 *  Three values, not two: "this tells us nothing" is different from
 *  "this went fine". A breaker that treats them alike lets an ignored
 *  outcome ERASE a run of real failures - a service answering 500 on
 *  one route and 501 on another never trips, because each 501 zeroes
 *  the count the 500s built up.
 *
 *  sony/gobreaker draws the same three-way line: a success clears the
 *  consecutive-failure count, a failure increments it, and an
 *  exclusion touches neither. */
export type Outcome = 'healthy' | 'unwell' | 'ignore'

/** A permanent statement about THIS REQUEST rather than evidence
 *  about the service: the route is not implemented (501), or the
 *  HTTP version is not spoken (505). Neither changes after a
 *  cooldown, so neither is worth a retry or a place in the count. */
function permanentProtocolError(status: number): boolean {
  return status === 501 || status === 505
}

function classify(
  res: Response | undefined,
  err: unknown,
  caller: AbortSignal | undefined
): Outcome {
  if (err !== undefined) {
    // Whose signal aborted? Our own per-attempt timeout arrives as
    // an abort too, and a service too slow to answer within it IS
    // unwell - that is a case the breaker exists for. So the
    // question is not what the error says, it is whether the
    // CALLER's signal is the one that fired.
    return caller?.aborted === true ? 'ignore' : 'unwell'
  }
  if (res === undefined) return 'ignore'
  if (permanentProtocolError(res.status)) return 'ignore'
  return res.status >= 500 ? 'unwell' : 'healthy'
}

/** A backoff that a caller can cut short. Rejects with the signal's
 *  own reason, so an aborted call fails the way fetch would have. */
function abortableDelay(ms: number, signal?: AbortSignal | null): Promise<void> {
  if (signal?.aborted === true) return Promise.reject(signal.reason)
  return new Promise((resolve, reject) => {
    const timer = setTimeout(() => {
      signal?.removeEventListener('abort', onAbort)
      resolve()
    }, ms)
    const onAbort = () => {
      clearTimeout(timer)
      reject(signal?.reason)
    }
    signal?.addEventListener('abort', onAbort, { once: true })
  })
}

// A POST may already have applied, so retrying it can create a second thing.
const IDEMPOTENT = new Set(['GET', 'HEAD', 'OPTIONS', 'PUT', 'DELETE'])

function retryable(req: Request, res: Response | undefined, err: unknown): boolean {
  if (!IDEMPOTENT.has(req.method)) return false
  if (err !== undefined) return true
  if (res === undefined) return false
  // Same carve-out the breaker makes: a permanently unimplemented
  // route does not become implemented on the next attempt.
  if (permanentProtocolError(res.status)) return false
  return res.status === 429 || res.status >= 500
}

// One retry, a second later. The default.
export const singleRetry: RetryPolicy = {
  backoffs: () => [1000],
  retry: retryable,
}

// Five jittered attempts, for a slow-but-not-broken dependency. Jitter
// so a fleet of callers does not retry in lockstep.
export const exponentialRetry: RetryPolicy = {
  backoffs: () => {
    const out: number[] = []
    let next = 100
    for (let i = 0; i < 5; i++) {
      out.push(next + (Math.random() * 2 - 1) * 0.25 * next)
      next *= 2
    }
    return out
  },
  retry: retryable,
}

export const noRetry: RetryPolicy = { backoffs: () => [], retry: () => false }

// Reads the server's own answer to "when should I come back". RFC 9110
// allows either a delay in seconds or an HTTP-date. Capped so an
// hour-long value cannot masquerade as a hang.
/** The server's own answer, and whether it asked for longer than we
 *  will wait. `tooLong` means STOP - returning undefined for it sent
 *  the caller back to its own backoff, so a server asking for an hour
 *  was retried in a second, which is the opposite of what it asked
 *  for at the moment it was most emphatic. */
export function retryAfterMs(
  res: Response | undefined,
  maxMs: number
): { ms?: number; tooLong: boolean } {
  const v = res?.headers?.get('retry-after')
  if (!v) return { tooLong: false }

  let ms
  const secs = Number(v.trim())
  if (Number.isInteger(secs)) {
    if (secs < 0) return { tooLong: false }
    ms = secs * 1000
  } else {
    const when = Date.parse(v)
    if (Number.isNaN(when)) return { tooLong: false }
    ms = Math.max(0, when - Date.now())
  }
  return ms > maxMs ? { tooLong: true } : { ms, tooLong: false }
}

export class CircuitOpenError extends Error {
  constructor() {
    super('circuit open')
    this.name = 'CircuitOpenError'
  }
}

export class Breaker {
  #failures = 0
  #probing = false
  #openedAt = 0
  readonly failedRequests: number
  readonly cooldownMs: number

  /** failedRequests is how many consecutive failed REQUESTS open the
   *  circuit. A request that exhausted its retries counts once. */
  constructor(failedRequests = 5, cooldownMs = 30_000) {
    this.failedRequests = failedRequests
    this.cooldownMs = cooldownMs
  }

  allow(): boolean {
    if (this.#failures < this.failedRequests) return true
    // Open. One caller past the cooldown gets through to find out
    // whether the dependency is back; everyone else waits for its
    // verdict rather than joining it. Zeroing the count here instead
    // would release every waiting caller at something that has just
    // proved it is struggling.
    if (!this.#probing && Date.now() - this.#openedAt > this.cooldownMs) {
      this.#probing = true
      return true
    }
    return false
  }
  /** Takes the probe slot back if this request held it, updates the
   *  failure run, and re-arms the cooldown when the circuit is open
   *  and this request did not prove recovery. */
  record(o: Outcome): void {
    const probe = this.#probing
    this.#probing = false

    // Each outcome declares what it PROVED, and the clock below
    // reads those rather than the outcome's name. An outcome added
    // later has to say so to count as recovery or as a failure, and
    // silence gets the conservative answer on both.
    let recovered = false
    let extended = false
    switch (o) {
      case 'healthy':
        this.#failures = 0
        recovered = true
        break
      case 'unwell':
        this.#failures++
        extended = true
        break
      case 'ignore':
        // Tells us nothing, so the run stands.
        break
    }

    // A probe that did not prove recovery spends its slot and costs
    // a full cooldown, or an open circuit hands a fresh probe to
    // every caller the moment the first reports back.
    if (probe && !recovered) {
      this.#openedAt = Date.now()
      return
    }

    // A failure moves the clock so the cooldown is measured from the
    // last one rather than the first.
    //
    // >= not ===: requests already in flight when the breaker
    // tripped land afterwards, and with === their failures would not
    // move it, so the cooldown would expire early.
    if (extended && this.#failures >= this.failedRequests) {
      this.#openedAt = Date.now()
    }
  }
}

/**
 * The transport on its own: a `fetch` that times out, retries, obeys
 * Retry-After and trips a breaker.
 *
 * Exported separately from createClient because a consumer does not
 * always get to build the client. A generated package also ships a
 * module-level client that its operations fall back to, and an app
 * that wants its call sites to omit `client:` configures THAT one
 * with setConfig - which takes a fetch, not a client. Without this
 * the only way to get the retries was to build a second client the
 * operations would not use.
 *
 * Compose it with whatever else the caller's transport has to do:
 *
 *   fetch: (input, init) => resilientFetch(withAuth(input, init))
 */
export function createResilientFetch({
  // CALLER's own service name, sent as Client-Name.
  name,
  timeoutMs = 5000,
  policy = singleRetry,
  breaker,
  maxRetryAfterMs = 30_000,
}: Omit<ClientOptions, 'baseUrl'> = {}) {
  return async (input: RequestInfo | URL, init?: RequestInit) => {
    const req = new Request(input, init)
    // Read off init rather than req.signal: Request always has one,
    // so req.signal cannot tell "the caller passed a signal" from
    // "the caller did not".
    const caller = init?.signal ?? undefined
    req.headers.set(ClientVersionHeader, ClientVersion)
    if (name) req.headers.set(ClientNameHeader, name)

    if (breaker && !breaker.allow()) throw new CircuitOpenError()

    const backoffs = policy.backoffs()
    let res: Response | undefined
    let err: unknown

    // try/finally so EVERY exit reports back, including the abort
    // that abortableDelay throws. allow() hands out the half-open
    // probe and only record() takes it back: a probe that leaves
    // without reporting leaves the breaker believing it is still in
    // flight, and allow() then refuses everyone for good. Wedged
    // closed does not heal.
    try {
      for (let attempt = 0; ; attempt++) {
        err = undefined
        try {
          // The caller's own signal is combined with the per-attempt
          // timeout rather than replaced by it: a caller that aborts
          // must stop the whole call, not just lose one attempt.
          res = await fetch(req.clone(), {
            signal: caller
              ? AbortSignal.any([caller, AbortSignal.timeout(timeoutMs)])
              : AbortSignal.timeout(timeoutMs),
          })
        } catch (e) {
          err = e
          res = undefined
        }
        if (attempt >= backoffs.length || !policy.retry(req, res, err)) break

        // The server's Retry-After wins over the policy's backoff.
        const after = retryAfterMs(res, maxRetryAfterMs)
        if (after.tooLong) {
          // It asked for longer than we will wait. Hand the response
          // back rather than retrying sooner than it said.
          break
        }
        const wait = after.ms ?? backoffs[attempt]
        // Wait, unless the caller has already given up. A bare
        // setTimeout would hold the backoff for the server's full
        // Retry-After and then retry on behalf of nobody.
        await abortableDelay(wait, caller)
      }

    } finally {
      breaker?.record(classify(res, err, caller))
    }

    if (err !== undefined) throw err
    if (res === undefined) {
      // Unreachable: the loop leaves res set unless it also set err,
      // which threw above. Stated rather than asserted, so the day
      // someone adds a path out of the loop they get this instead of
      // a client handed undefined.
      throw new Error('request produced neither a response nor an error')
    }
    return res
  }
}

/** A configured transport for the generated operations. Pass it as
 *  `{ client }` to any of them.
 *
 *  Most callers do not need this: the operations fall back to a
 *  module-level client, and a consumer that configures THAT one -
 *  with createResilientFetch - gets the same behaviour without
 *  naming a client at every call. Reach for this to run several
 *  clients with different policies, or against different hosts. */
export function createClient({ baseUrl, ...options }: ClientOptions) {
  const resilientFetch = createResilientFetch(options)

  // THE ADAPTER. The one place that knows which generator produced the
  // operations: it hands them a configured transport.
  const client = createGeneratedClient(createConfig({ baseUrl, fetch: resilientFetch }))

  // Keep fetch's own split between the two kinds of failure.
  //
  // An HTTP error status is an ANSWER: the server replied, and the
  // reply is "no". Callers branch on those - 401 means re-auth, 409
  // means conflict - so they arrive as { error }, and throwing would
  // wrap ordinary control flow in try/catch.
  //
  // A transport failure is NOT an answer. There is no status, nothing
  // to branch on, and the caller can only give up. fetch rejects for
  // these and resolves for the first; the generated client returns
  // { error } for both, so this puts the distinction back.
  //
  // `response` is undefined exactly when the request never completed,
  // which is the test. throwOnError is not usable as a default here:
  // it throws for a 404 too.
  //
  // What this returns stays the SERVER'S PARSED BODY, deliberately
  // not wrapped in an Error class. The client uses ONE value for
  // both outcomes - `y = await interceptor(...)`, then either
  // `throw y` under throwOnError or `return { error: y }` without it
  // - so a wrapper cannot apply to the throwing case alone. It would
  // also reach consumers that forward the body onward, turning
  // `reply.code(409).send(error)` into a response carrying our class
  // name and internal URL instead of the API's own error.
  //
  // An API wanting an exception passes throwOnError per call and
  // converts at its own boundary, where the body's shape is known.
  client.interceptors.error.use((error, response) => {
    if (response === undefined) {
      throw error instanceof Error ? error : new Error('request did not complete', { cause: error })
    }
    return error
  })

  return client
}
